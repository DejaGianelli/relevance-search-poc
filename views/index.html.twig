{% extends 'layouts/base.html.twig' %}

{% set active_menu = 'home' %}

{% block content %}
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-2xl font-bold">Products</h1>
        <form method="get" action="/" role="search" class="flex w-full gap-2 sm:max-w-md">
            <label for="search" class="sr-only">Search products by name or description</label>
            <input type="search" id="search" name="q" value="{{ query }}" placeholder="Search products"
                   class="min-w-0 flex-1 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-gray-900 focus:outline-none">
            <button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">Search</button>
        </form>
    </div>

    {% if query %}
        <p class="mb-4 text-sm text-gray-600">
            {{ pagination.total|number_format }}{{ pagination.capped ? '+' }} result{{ pagination.total != 1 ? 's' }} for <span class="font-medium text-gray-900">&ldquo;{{ query }}&rdquo;</span>,
            ranked by relevance and rating.
            <a href="/" class="font-medium text-gray-900 underline">Clear search</a>
        </p>
    {% endif %}

    {% if products is empty %}
        <div class="rounded-lg border border-dashed border-gray-300 bg-white p-10 text-center text-sm text-gray-500">
            {{ query ? 'No products match your search.' : 'No products available yet.' }}
        </div>
    {% else %}
        <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {% for product in products %}
                {% set my_stars = my_ratings[product.id.toRfc4122] ?? 0 %}
                <li id="product-{{ product.id }}" class="flex scroll-mt-20 flex-col rounded-lg border border-gray-200 bg-white p-5">
                    <div class="flex items-start justify-between gap-4">
                        <h2 class="font-semibold">{{ product.name }}</h2>
                        <span class="whitespace-nowrap font-semibold tabular-nums">{{ product.price|number_format(2) }}</span>
                    </div>

                    {% if product.description %}
                        <p class="mt-1 line-clamp-2 text-sm text-gray-600">{{ product.description }}</p>
                    {% endif %}

                    <div class="mt-3">
                        {% include 'partials/rating_stars.html.twig' with { average: product.ratingAverage, count: product.ratingCount } only %}
                    </div>

                    <form method="post" action="/products/{{ product.id }}/rate" data-rating class="mt-auto flex items-center gap-3 border-t border-gray-100 pt-3 text-sm">
                        <input type="hidden" name="page" value="{{ pagination.page }}">
                        {% if query %}<input type="hidden" name="q" value="{{ query }}">{% endif %}
                        <span class="text-gray-500">{{ my_stars ? 'Your rating' : 'Rate it' }}</span>
                        <div class="flex" data-rating-value="{{ my_stars }}">
                            {% for n in 1..5 %}
                                <button type="submit" name="stars" value="{{ n }}"
                                        aria-label="Rate {{ n }} star{{ n > 1 ? 's' }}" aria-pressed="{{ n == my_stars ? 'true' : 'false' }}"
                                        class="rounded p-0.5 {{ n <= my_stars ? 'text-amber-400' : 'text-gray-300' }} focus-visible:outline-2 focus-visible:outline-gray-900">
                                    <svg class="size-6" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z"/>
                                    </svg>
                                </button>
                            {% endfor %}
                        </div>
                    </form>
                </li>
            {% endfor %}
        </ul>

        {% include 'partials/pagination.html.twig' with { pagination: pagination, base_url: '/', params: query ? { q: query } : {} } only %}
    {% endif %}
{% endblock %}

{% block scripts %}
    <script src="/js/rating.js"></script>
{% endblock %}
