{% extends 'layouts/base.html.twig' %}

{% set active_menu = 'products' %}

{% block title %}Products · Relevance Search{% endblock %}

{% block content %}
    <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="text-2xl font-bold">Products</h1>
        <a href="/products/new" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
            New product
        </a>
    </div>

    {% if products is empty %}
        <div class="rounded-lg border border-dashed border-gray-300 bg-white p-10 text-center text-sm text-gray-500">
            No products yet. <a href="/products/new" class="font-medium text-gray-900 underline">Create the first one</a>.
        </div>
    {% else %}
        <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                    <tr>
                        <th class="px-4 py-3">Name</th>
                        <th class="px-4 py-3">SKU</th>
                        <th class="px-4 py-3 text-right">Price</th>
                        <th class="px-4 py-3 text-right">Stock</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for product in products %}
                        <tr>
                            <td class="px-4 py-3 font-medium">{{ product.name }}</td>
                            <td class="px-4 py-3 font-mono text-xs text-gray-600">{{ product.sku }}</td>
                            <td class="px-4 py-3 text-right tabular-nums">{{ product.price|number_format(2) }}</td>
                            <td class="px-4 py-3 text-right tabular-nums">{{ product.stock }}</td>
                            <td class="px-4 py-3">
                                {% if product.active %}
                                    <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Active</span>
                                {% else %}
                                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Inactive</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex justify-end gap-3">
                                    <a href="/products/{{ product.id }}/edit" class="font-medium text-gray-900 hover:underline">Edit</a>
                                    <form method="post" action="/products/{{ product.id }}/delete" data-confirm="Delete &quot;{{ product.name }}&quot;?">
                                        <button type="submit" class="font-medium text-red-600 hover:underline">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'partials/pagination.html.twig' with { pagination: pagination, base_url: '/products' } only %}
    {% endif %}
{% endblock %}

{% block scripts %}
    <script src="/js/confirm.js"></script>
{% endblock %}
