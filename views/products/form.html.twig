{% extends 'layouts/base.html.twig' %}

{% set active_menu = 'products' %}
{% set is_edit = product is not null %}
{% set input_class = 'mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-gray-900 focus:outline-none' %}

{% macro error(errors, field) %}
    {% if errors[field] is defined %}
        <p class="mt-1 text-sm text-red-600">{{ errors[field] }}</p>
    {% endif %}
{% endmacro %}

{% block title %}{{ is_edit ? 'Edit product' : 'New product' }} · Relevance Search{% endblock %}

{% block content %}
    <div class="mb-6">
        <a href="/products" class="text-sm text-gray-500 hover:text-gray-900">&larr; Products</a>
        <h1 class="mt-1 text-2xl font-bold">{{ is_edit ? 'Edit product' : 'New product' }}</h1>
    </div>

    <form method="post" action="{{ is_edit ? '/products/' ~ product.id : '/products' }}" class="max-w-2xl space-y-5 rounded-lg border border-gray-200 bg-white p-6">
        <div>
            <label for="name" class="block text-sm font-medium">Name</label>
            <input type="text" id="name" name="name" value="{{ values.name }}" required maxlength="255" class="{{ input_class }}">
            {{ _self.error(errors, 'name') }}
        </div>

        <div>
            <label for="sku" class="block text-sm font-medium">SKU</label>
            <input type="text" id="sku" name="sku" value="{{ values.sku }}" required maxlength="64" class="{{ input_class }} font-mono uppercase">
            {{ _self.error(errors, 'sku') }}
        </div>

        <div>
            <label for="description" class="block text-sm font-medium">Description</label>
            <textarea id="description" name="description" rows="4" class="{{ input_class }}">{{ values.description }}</textarea>
            {{ _self.error(errors, 'description') }}
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label for="price" class="block text-sm font-medium">Price</label>
                <input type="text" id="price" name="price" value="{{ values.price }}" required inputmode="decimal" placeholder="0.00" class="{{ input_class }}">
                {{ _self.error(errors, 'price') }}
            </div>
            <div>
                <label for="stock" class="block text-sm font-medium">Stock</label>
                <input type="number" id="stock" name="stock" value="{{ values.stock }}" required min="0" step="1" class="{{ input_class }}">
                {{ _self.error(errors, 'stock') }}
            </div>
        </div>

        <label class="flex items-center gap-2 text-sm font-medium">
            <input type="checkbox" name="active" value="1" {{ values.active ? 'checked' }} class="size-4 rounded border-gray-300">
            Active
        </label>

        <div class="flex items-center gap-3 border-t border-gray-100 pt-5">
            <button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
                {{ is_edit ? 'Save changes' : 'Create product' }}
            </button>
            <a href="/products" class="text-sm text-gray-600 hover:text-gray-900">Cancel</a>
        </div>
    </form>
{% endblock %}
